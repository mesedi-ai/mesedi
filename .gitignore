*.swp

# Env
.env
.env.local
backend/.env

# Future subdirs
sdk-python/__pycache__/
sdk-python/.venv/
sdk-python/dist/
sdk-python/*.egg-info/
sdk-typescript/node_modules/
sdk-typescript/dist/
sdk-typescript/dist-sandbox/
