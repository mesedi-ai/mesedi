# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
/bin/
/dist/
/build/

# Go test artifacts
*.test
*.out
coverage.txt
coverage.html

# IDE
.idea/
.vscode/

# Local environment
.env
.env.local
*.local.yml

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local database files
*.db
*.sqlite
*.sqlite3

# Local config / secrets
config.local.*
secrets.local.*
mesedi-dev.db

# Fly deploy configs are machine-local. Only fly.toml (prod) is public.
# fly.staging.toml, fly.dev.toml, and any other per-environment overrides
# stay out of the public tree — they name internal hosts + secret refs.
fly.staging.toml
fly.dev.toml
fly.*.toml
!fly.toml

# Stress-test config swap backups. The harness workflow copies the
# tracked prod config aside as `stress-test.config.sh.prod-bak` before
# dropping the staging override in, then restores it. If the workflow
# is interrupted the backup lingers — this rule keeps it from ever
# being staged accidentally.
*.prod-bak
*.staging-bak
